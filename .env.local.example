# ─── SEGURIDAD ────────────────────────────────────────────────────────────────
# Agregar .env.local a .gitignore — NUNCA commitear este archivo.

# ── Helius ────────────────────────────────────────────────────────────────────
# https://dashboard.helius.dev/
HELIUS_API_KEY=tu_api_key_aqui

# ── Jupiter ───────────────────────────────────────────────────────────────────
# https://portal.jup.ag/
JUPITER_API_KEY=tu_jupiter_key_aqui

# ── Wallet (server-side only — NUNCA exponer) ─────────────────────────────────
# Formato JSON array (Solana CLI): [1,2,3,...,64]
# Formato base58 (Phantom export): 5KtR...
# USAR WALLET DEDICADA — nunca tu wallet principal
WALLET_PRIVATE_KEY=tu_private_key_aqui

# ── Wallet pública (display — seguro exponer) ─────────────────────────────────
NEXT_PUBLIC_WALLET_ADDRESS=tu_wallet_publica_aqui

# ── Rebate address (opcional) ─────────────────────────────────────────────────
# Recibe el 50% del MEV. Por defecto va a la wallet que firma.
# Útil si querés redirigir el rebate a otra wallet (ej: wallet principal).
# REBATE_ADDRESS=

# ── API secret (opcional pero MUY recomendado si deployás) ────────────────────
# Protege las rutas que firman TX (/api/swap, /api/position, /api/pool, /api/damm).
# Si está seteado, esas rutas exigen el header: Authorization: Bearer <API_SECRET>
# Si NO está seteado, no bloquea (modo local single-user).
# Sin esto, una app deployada es un open relay para gastar la wallet.
# API_SECRET=

# ── Cluster (opcional) ────────────────────────────────────────────────────────
# devnet | mainnet-beta (default). En devnet se habilita /api/airdrop.
# NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
